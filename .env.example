# Portside Configuration
PORTSIDE_DATA_PATH=".portside"
# Generate a long random value for production. Existing sessions are invalidated when this changes.
JWT_SECRET="replace_with_a_long_random_session_secret"
PORTSIDE_PORT="3000"
# Optional token for /host/status. TXHOST_API_TOKEN is also accepted as a compatibility alias.
PORTSIDE_HOST_API_TOKEN=""
# Optional log retention in days for PORTSIDE_DATA_PATH/logs.
# The Diagnostics page reports log/data path health and redacts configured secrets.
PORTSIDE_LOG_RETENTION_DAYS="14"

# FXServer lifecycle mode. External keeps Portside read/RCON-only; managed lets Portside launch and restart FXServer.
PORTSIDE_FXSERVER_MODE="external"
PORTSIDE_FXSERVER_BINARY=""
# Optional. If empty, managed mode uses the folder from FIVEM_SERVER_CFG_PATH.
PORTSIDE_FXSERVER_CWD=""
# Optional. If empty, managed mode uses +exec with the filename from FIVEM_SERVER_CFG_PATH.
# Example: +exec server.cfg
PORTSIDE_FXSERVER_ARGS=""
PORTSIDE_FXSERVER_RESTART_ON_CRASH="false"
PORTSIDE_FXSERVER_STOP_TIMEOUT_MS="10000"

FIVEM_SERVER_URL="http://your-fivem-server-ip:30120"
# Absolute path to the FiveM server.cfg that Portside can read and write.
FIVEM_SERVER_CFG_PATH="C:/path/to/txData/default/server.cfg"
FIVEM_RCON_PASSWORD="your_fivem_rcon_password"
# Optional overrides. Defaults come from FIVEM_SERVER_URL.
FIVEM_RCON_HOST=""
FIVEM_RCON_PORT=""
# Optional framework-specific ban command template.
# Tokens: {id}, {reason}, {duration}
FIVEM_RCON_BAN_COMMAND=""

# Optional Portside monitor resource bridge.
# Set the same random secret in FiveM as: set portside_monitor_token "..."
PORTSIDE_MONITOR_TOKEN=""
# Optional, off by default to avoid conflicts with a real txAdmin instance.
PORTSIDE_MONITOR_COMPAT_TXADMIN_COMMANDS="false"

# Optional whitelist and Discord status integration.
# disabled: never block joins. dry-run: log would-block joins. enforced: deny unapproved joins.
PORTSIDE_WHITELIST_MODE="disabled"
# Discord token stays in env only. Create a bot in the Discord developer portal and invite it to your guild.
PORTSIDE_DISCORD_BOT_TOKEN=""
PORTSIDE_DISCORD_GUILD_ID=""
PORTSIDE_DISCORD_STATUS_CHANNEL_ID=""
PORTSIDE_DISCORD_STATUS_MESSAGE_ID=""
PORTSIDE_DISCORD_STATUS_INTERVAL_SECONDS="60"

# Optional Cfx.re provider login (OAuth-style). Password login remains available as fallback.
# If CLIENT_ID and CLIENT_SECRET are unset, provider login is disabled.
PORTSIDE_CFX_CLIENT_ID=""
PORTSIDE_CFX_CLIENT_SECRET=""
# Optional overrides for provider endpoints and callback.
PORTSIDE_CFX_AUTH_URL="https://forum.cfx.re/session/sso_provider"
PORTSIDE_CFX_TOKEN_URL="https://forum.cfx.re/user-api-key/sso"
PORTSIDE_CFX_USERINFO_URL="https://forum.cfx.re/session/current.json"
PORTSIDE_CFX_REDIRECT_URI=""
PORTSIDE_CFX_SCOPE="openid profile"

# Database Configuration (MySQL / MariaDB)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="fivem"

# Debug Mode Toggles
# Set both to 'true' only for local demos. This bypasses real auth and grants all permissions.
VITE_DEBUG="false"
DEBUG="false"
