# Portside Configuration
JWT_SECRET="your_jwt_secret_here"
FIVEM_SERVER_URL="http://your-fivem-server-ip:30120"
# Absolute path to the FiveM server.cfg that Portside can read and write.
FIVEM_SERVER_CFG_PATH="C:/path/to/txData/default/server.cfg"
FIVEM_RCON_PASSWORD="your_fivem_rcon_password"
# Optional overrides. Defaults come from FIVEM_SERVER_URL.
FIVEM_RCON_HOST=""
FIVEM_RCON_PORT=""
# Optional framework-specific ban command template.
# Tokens: {id}, {reason}, {duration}
FIVEM_RCON_BAN_COMMAND=""

# Database Configuration (MySQL / MariaDB)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="fivem"

# Debug Mode Toggles
# Set both to 'true' to run the application in a demo state, bypassing auth & DB requirements
VITE_DEBUG="false"
DEBUG="false"
